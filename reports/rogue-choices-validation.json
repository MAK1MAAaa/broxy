  "scope": "Two mutually-exclusive run cores, optional wave2 hunter contract and once-only chosen rune reward, existing grave-candle adjacency priority, three per-next-wave route choices, persistent horizontal starter unlocks. No new currency or permanent stat bonuses.",
  "first_pass_balance": {
    "bone_core": "Always grants1paid0bone even if owned; independent UID every3attacks adds2side shots at55% damage, socket/rank inherited.",
    "frost_core": "Fills missing frost+ember. Slowed-target priority, consume slow on direct ember hit; radius48/50% secondary splash excludes prior direct hits, no recursive core/rune.",
    "kit_adjustment": "Initial bone-owned kit received no item while frostfire filled2weapons; fixed by always_grant bone, not raising side-shot damage. Nominal all-hit bone-start generation83.19/s vs frostfire78.70/s (excluding frostfire splash); not actual DPS or final balancing.",
    "routes": {
      "swarm": "ceil(baseCount*1.2), chaser80/rusher20, interval unchanged, win+4currency only",
      "bulwark": "ceil(baseCount*0.5), tank75/caster25, interval*1.15, win+6currency only",
      "boss": "unchanged composition and timer; choices reset tobalanced"
    },
    "hunter": "One extra rusher inwave3 after wave2 acceptance; health1.8x/speed1.15x; kill required, reward remains pending until capacity is available in a won-wave shop."
  },
