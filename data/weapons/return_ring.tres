script = ExtResource("1")
id = "return_ring"
kind = "weapon"
display_name = "止战徽记"
subtitle = "返航法器 · 位移回收"
description = "掷出可额外贯穿1个目标的徽记；未耗尽时0.60秒后以460速度追随当前玩家返航，同一弹体全航程不重复命中同一敌人。成功弹射改为追击邻敌，不再返航；爆破在第二个直接命中处触发，爆破或命中次数耗尽即消失。接触玩家或2.40秒寿命结束时回收，不回复生命或魂屑；发射冷却独立于回收。"
shop_summary = "0.60秒后追随玩家返航；全航程不重击同敌。符文从第二命中触发；成功弹射取消返航。"
